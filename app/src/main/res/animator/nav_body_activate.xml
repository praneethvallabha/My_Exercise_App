<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator android:propertyName="strokeWidth"
        android:valueFrom="1.7" android:valueTo="2.5" android:valueType="floatType"
        android:duration="240" android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator android:propertyName="fillAlpha"
        android:valueFrom="0.0" android:valueTo="0.22" android:valueType="floatType"
        android:duration="280" android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
